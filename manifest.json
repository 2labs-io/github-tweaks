{
  "manifest_version": 3,
  "name": "GitHub Tweaks",
  "short_name": "GH Tweaks",
  "version": "0.1.0",
  "description": "Small quality-of-life tweaks for GitHub that feel native. Starts with an in-page image lightbox for issues and pull requests.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "GitHub Tweaks",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "permissions": ["storage", "downloads"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": [
        "src/shared/tweaks.js",
        "src/content/core.js",
        "src/content/octicons.js",
        "src/tweaks/image-lightbox/image-lightbox.js"
      ],
      "css": ["src/tweaks/image-lightbox/image-lightbox.css"],
      "run_at": "document_idle"
    }
  ]
}
